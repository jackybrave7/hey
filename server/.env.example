# Режим хранения медиафайлов: local (разработка) | s3 (продакшн)
STORAGE_MODE=local

# S3 настройки TimeWeb Cloud Storage (только для STORAGE_MODE=s3)
# Получить ключи: https://timeweb.cloud → S3 хранилище → API ключи
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=heymessenger
S3_ACCESS_KEY=YOUR_ACCESS_KEY_HERE
S3_SECRET_KEY=YOUR_SECRET_KEY_HERE
S3_PUBLIC_URL_BASE=https://s3.twcstorage.ru/heymessenger

# ── AWO (АвтоВебОфис) интеграция ─────────────────────────────────────────────
# Имя школьного аккаунта (показывается ученикам в badge при регистрации)
AWO_SCHOOL_NAME=BL School

# Секретный токен webhook'а. Прописывается в АВО при настройке webhook:
#   https://hey-messenger.ru/api/integrations/awo/webhook?token=<TOKEN>
# Или передаётся в заголовке X-AWO-Token.
AWO_WEBHOOK_TOKEN=change-me-to-random-string

# Секрет HMAC для подписи /join-ссылок (тот же ключ должен использовать
# бизнес-процесс АВО для подстановки sig в персональную ссылку).
AWO_JOIN_SECRET=change-me-to-another-random-string

# Базовый URL HEY (для генерации абсолютных /join-ссылок из админки)
# Если не задан — берётся из заголовков запроса.
# PUBLIC_URL=https://hey-messenger.ru

